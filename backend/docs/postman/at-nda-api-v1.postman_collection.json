{
  "info": {
    "name": "AT-NDA API v1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:8000" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "POST /api/v1/auth/login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"index_number\": \"BC/ITD/24/047\",\n  \"password\": \"your-password\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/auth/login"
      }
    },
    {
      "name": "GET /api/v1/profile",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/v1/profile"
      }
    },
    {
      "name": "GET /api/v1/sessions/active",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/v1/sessions/active?include_missed_warnings=1"
      }
    },
    {
      "name": "POST /api/v1/attendance",
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"course_id\": 1,\n  \"session_id\": 1,\n  \"lat\": 5.6037,\n  \"lng\": -0.1870\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/v1/attendance"
      }
    },
    {
      "name": "POST /api/v1/auth/logout",
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/v1/auth/logout"
      }
    },
    {
      "name": "GET /api/v1/settings",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/settings"
      }
    }
  ]
}
