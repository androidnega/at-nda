APP_NAME=a-tenda
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# =============================================================================
# PRODUCTION DEPLOY CHECKLIST  (Phase 1 — read me before going live)
# =============================================================================
# When APP_ENV=production, App\Providers\AppServiceProvider refuses to boot
# unless ALL of the following are satisfied:
#   - QR_SECRET is non-empty           -> run: php artisan qr:rotate-secret
#   - DB_CONNECTION=mysql              -> not sqlite
#   - CACHE_STORE=file (or redis)      -> not database
#   - CORS_ALLOWED_ORIGINS contains no localhost / 127.0.0.1 / 0.0.0.0
# The guard also Log::warning when SANCTUM_TOKEN_EXPIRATION is unset
# (tokens would never expire — audit finding M-03). Artisan commands
# (queue:work, migrate, qr:rotate-secret, tinker) are exempt from the
# guard so the operator can always repair a broken env.
#
# REQUIRED cPanel cron entries (Phase 7 Task 1 installs these in the
# cPanel "Cron Jobs" UI — they are not auto-installed by this file):
#   * * * * * /usr/local/bin/ea-php83 /home/USER/public_html/artisan \
#           schedule:run >> /home/USER/logs/scheduler.log 2>&1
#   * * * * * /usr/local/bin/ea-php83 /home/USER/public_html/artisan \
#           queue:work --stop-when-empty --max-time=50 --tries=3 --backoff=10 \
#           >> /home/USER/logs/queue.log 2>&1
# Without the queue:work entry, uploaded profile photos stay on the
# 1x1 placeholder PNG forever (see app/Jobs/ResizeStudentProfileImage.php
# wired in P1.T16).
#
# QUEUE HEALTH (paste into phpMyAdmin or `php artisan tinker`):
#   SELECT COUNT(*) FROM jobs;                              -- < 10 healthy
#   SELECT COUNT(*) FROM failed_jobs
#     WHERE failed_at > NOW() - INTERVAL 1 HOUR;            -- 0  healthy
#   SELECT COUNT(*) FROM students
#     WHERE profile_image LIKE 'pending:%';                 -- < 5 healthy
# =============================================================================

# Application timezone (Carbon, session times, attendance dates)
APP_TIMEZONE=Africa/Accra

# Signed QR payloads (HMAC-SHA256). REQUIRED in production.
# Generate with:
#   php artisan qr:rotate-secret          (recommended — also re-signs
#                                          every active session in DB)
#   php -r "echo bin2hex(random_bytes(32));"   (alternative)
# Leave empty for legacy plain qr_token (LOCAL DEV ONLY). The production
# boot guard (AppServiceProvider) refuses to start when this is empty
# while APP_ENV=production. WARNING: rotating this value invalidates
# every QR code that deployed Flutter APKs were built against — see
# P1_T11_QR_ROTATION_ANALYSIS.txt before rotating in production.
QR_SECRET=
# Inner expiry in signed payload (minutes), capped by session end_time
QR_TOKEN_TTL_MINUTES=2

# Missed session warnings (GET /api/attendance/missed-warnings): min ended sessions without attendance to flag
# MISSED_WARNING_MIN_SESSIONS=2
# Optional: only count sessions ended in the last N days (omit = all time)
# MISSED_WARNING_LOOKBACK_DAYS=

# Geofence: nominal radius when course/session have no value (meters; target band ~150–200)
DEFAULT_ATTENDANCE_RANGE_M=200
# Extra meters added server-side for GPS inaccuracy (indoor / jitter)
GEOFENCE_GPS_BUFFER_M=50
# Floor (meters) for max(nominal, floor) + buffer — keeps “safe” real-world radius
MIN_GEOFENCE_CHECK_M=150

# Optional: override sign-in hero image (URL or path under public/, e.g. images/auth/lecturer-laptop-attendance-system-login.jpg)
# AUTH_HERO_IMAGE=images/auth/lecturer-laptop-attendance-system-login.jpg

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Set to `true` ONLY during the one-shot student password rehash window.
# When true, App\Support\PasswordPolicy::matches() falls back to a
# constant-time plaintext compare for rows whose `password` column is
# not yet bcrypt-shaped. Flip back to `false` IMMEDIATELY AFTER
#   php artisan students:rehash-passwords
# reports "Remaining non-bcrypt rows: 0". Default is `false` (= reject
# plaintext everywhere — the Phase 1 target state, audit finding C-06).
AUTH_ALLOW_LEGACY_PLAINTEXT=false

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=7
LOG_DEPRECATIONS_CHANNEL=null
# `debug` floods storage/logs/ on production (every query, every cache
# hit). Use `info` (or `warning`) in production; `debug` is fine locally.
LOG_LEVEL=info

# Local dev uses sqlite for zero-config setup. PRODUCTION MUST USE
# MYSQL OR MARIADB — the AppServiceProvider boot guard refuses to start
# with DB_CONNECTION=sqlite when APP_ENV=production. On a cPanel deploy
# switch the value below to `mysql` and uncomment the four DB_* lines.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# API v1 — Laravel Sanctum (Bearer tokens). Token lifetime in minutes.
# 10080 = 7 days (Phase 1 / audit M-03 target). Leaving this empty means
# tokens NEVER expire — a stolen mobile token then grants permanent
# access. config/sanctum.php reads this directly; no code change needed.
SANCTUM_TOKEN_EXPIRATION=10080

# CORS: comma-separated origins allowed to call /api/* from browser apps.
# Add your production web origins here.
CORS_ALLOWED_ORIGINS=http://localhost:8082,http://127.0.0.1:8082,http://0.0.0.0:8082

BROADCAST_CONNECTION=reverb

# Laravel Reverb (WebSockets) — run: php artisan reverb:start
# For Vite, expose the same values with VITE_ prefix so the browser can connect.
REVERB_APP_ID=100001
REVERB_APP_KEY=local-reverb-key
REVERB_APP_SECRET=local-reverb-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
FILESYSTEM_DISK=local

# Queued jobs land in the `jobs` table. They are NOT processed until
# `php artisan queue:work` is running (manually OR via the Phase 7 cron
# entry — see the PRODUCTION DEPLOY CHECKLIST at the top of this file).
# Without the drainer, profile-image uploads (P1.T16 — see
# app/Jobs/ResizeStudentProfileImage.php) stay on the placeholder PNG
# forever.
QUEUE_CONNECTION=database

# `database` writes to the cache table on every cache hit — fine for
# local dev, too slow for production. The AppServiceProvider boot guard
# refuses to start with CACHE_STORE=database when APP_ENV=production.
# Use `file` on shared hosting; `redis` when available (see the
# "Recommended for production" block below).
CACHE_STORE=file
# CACHE_PREFIX=

# === Recommended for production (peak attendance-marking traffic) ===
# Point cache + locks at Redis so all PHP workers share the
# AttendanceMarkLock and the LiveAttendanceCache. Concurrent students
# marking the same session collapse to one DB write instead of dog-piling
# the DB.
#   CACHE_STORE=redis
#   QUEUE_CONNECTION=redis   # optional, moves SessionLiveEvent off DB
#   BROADCAST_CONNECTION=redis  # only if you're not using Reverb
#
# REDIS_CLIENT can stay phpredis (preferred) or set to predis if the
# extension isn't installed.

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Firebase Cloud Messaging (legacy server key) — session-start push to class devices
FCM_SERVER_KEY=
