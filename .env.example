APP_NAME=a-tenda
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Application timezone (Carbon, session times, attendance dates)
APP_TIMEZONE=Africa/Accra

# Signed QR payloads (HMAC-SHA256). Generate: php -r "echo bin2hex(random_bytes(32));"
# Leave empty for legacy plain qr_token (local dev only).
QR_SECRET=
# Inner expiry in signed payload (minutes), capped by session end_time
QR_TOKEN_TTL_MINUTES=2

# Missed session warnings (GET /api/attendance/missed-warnings): min ended sessions without attendance to flag
# MISSED_WARNING_MIN_SESSIONS=2
# Optional: only count sessions ended in the last N days (omit = all time)
# MISSED_WARNING_LOOKBACK_DAYS=

# Geofence: nominal radius when course/session have no value (meters; target band ~150–200)
DEFAULT_ATTENDANCE_RANGE_M=200
# Extra meters added server-side for GPS inaccuracy (indoor / jitter)
GEOFENCE_GPS_BUFFER_M=50
# Floor (meters) for max(nominal, floor) + buffer — keeps “safe” real-world radius
MIN_GEOFENCE_CHECK_M=150

# Optional: override sign-in hero image (URL or path under public/, e.g. images/auth/lecturer-laptop-attendance-system-login.jpg)
# AUTH_HERO_IMAGE=images/auth/lecturer-laptop-attendance-system-login.jpg

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# API v1 — Laravel Sanctum (Bearer tokens). Optional: token lifetime in minutes (null = no expiry).
# SANCTUM_TOKEN_EXPIRATION=10080

# CORS: comma-separated origins allowed to call /api/* from browser apps.
# Add your production web origins here.
CORS_ALLOWED_ORIGINS=http://localhost:8082,http://127.0.0.1:8082,http://0.0.0.0:8082

BROADCAST_CONNECTION=reverb

# Laravel Reverb (WebSockets) — run: php artisan reverb:start
# For Vite, expose the same values with VITE_ prefix so the browser can connect.
REVERB_APP_ID=100001
REVERB_APP_KEY=local-reverb-key
REVERB_APP_SECRET=local-reverb-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Firebase Cloud Messaging (legacy server key) — session-start push to class devices
FCM_SERVER_KEY=
